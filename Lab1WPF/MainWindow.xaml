<Window x:Class="Lab1WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ListView x:Name="lstStudents" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,268,154,32">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Vārds" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Uzvārds" DisplayMemberBinding="{Binding Surname}"/>
                    <GridViewColumn Header="App.Nr." DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Grupa" DisplayMemberBinding="{Binding Group}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Content="Vārds" HorizontalAlignment="Left" Margin="10,19,0,0" VerticalAlignment="Top" Height="25" Width="74"/>
        <Label Content="Uzvārds" HorizontalAlignment="Left" Margin="10,53,0,0" VerticalAlignment="Top" Height="25" Width="52"/>
        <Label Content="App.Nr." HorizontalAlignment="Left" Margin="10,104,0,0" VerticalAlignment="Top" Height="25" Width="52"/>
        <Label Content="Grupa" HorizontalAlignment="Left" Margin="10,129,0,0" VerticalAlignment="Top" Height="25" Width="52"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Margin="95,25,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114" Height="17"/>
        <TextBox x:Name="txtSurname" HorizontalAlignment="Left" Margin="95,59,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114" Height="17"/>
        <TextBox x:Name="txtId" HorizontalAlignment="Left" Margin="95,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114" Height="17"/>
        <TextBox x:Name="txtGroup" HorizontalAlignment="Left" Margin="95,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114" Height="17"/>
        <Button x:Name="btnAdd" Content="Pievienot" HorizontalAlignment="Left" Margin="212,175,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.809,0.62" Height="19" Width="53" Click="btnAdd_Click"/>
        <Label x:Name="nav" Content="Studenti" HorizontalAlignment="Left" Margin="10,217,0,0" VerticalAlignment="Top" Height="27" Width="74"/>
        <Button x:Name="btnLoad" Content="Ielādēt" HorizontalAlignment="Left" Margin="16,407,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.809,0.62" Height="19" Width="46" Click="btnLoad_Click"/>
        <Button x:Name="btnSave" Content="Saglabāt" HorizontalAlignment="Left" Margin="85,407,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.809,0.62" Height="19" Width="58" Click="btnSave_Click"/>

    </Grid>
</Window>
